@RaceDay.Api_HostAddress = http://localhost:5155

# Registering or logging in starts a server-side session; the session cookie is reused by later requests.

POST {{RaceDay.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "runner@raceday.co.za",
  "password": "DemoRaceDay123!",
  "firstName": "Taylor",
  "lastName": "Runner",
  "idNumberOrPassport": "TEST-ID-001",
  "role": "Participant"
}

###

POST {{RaceDay.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "runner@raceday.co.za",
  "password": "DemoRaceDay123!"
}

###

GET {{RaceDay.Api_HostAddress}}/api/users/me

###

POST {{RaceDay.Api_HostAddress}}/api/auth/logout
